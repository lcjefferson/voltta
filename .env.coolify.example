# Cole no Coolify → Environment Variables (Docker Compose resource)
# Troque POSTGRES_PASSWORD e JWT_* antes de produção real.

POSTGRES_USER=voltta
POSTGRES_PASSWORD=voltta-change-me-now
POSTGRES_DB=voltta

API_URL=https://api.volttaagenda.fortallabs.com.br
WEBHOOK_PUBLIC_URL=https://api.volttaagenda.fortallabs.com.br
WEB_URL=https://volttaagenda.fortallabs.com.br

JWT_ACCESS_SECRET=voltta-change-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=voltta-change-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# E-mail (recuperação de senha) — https://resend.com
RESEND_API_KEY=
MAIL_FROM=VOLTTA <onboarding@resend.dev>

UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_ADMIN_TOKEN=

# Super-admin: e-mail da sua conta VOLTTA (painel /admin)
PLATFORM_ADMIN_EMAILS=

NEXT_PUBLIC_API_URL=https://api.volttaagenda.fortallabs.com.br/v1
NEXT_PUBLIC_SITE_URL=https://volttaagenda.fortallabs.com.br
