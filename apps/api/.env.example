# Copie para apps/api/.env em desenvolvimento local
# Em Coolify, configure as mesmas chaves no painel do serviço API.

NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
WEBHOOK_PUBLIC_URL=http://localhost:3001
WEB_URL=http://localhost:3000

JWT_ACCESS_SECRET=voltta-dev-access-secret-change-me
JWT_REFRESH_SECRET=voltta-dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

DATABASE_URL=postgresql://voltta:voltta@localhost:15432/voltta?schema=public
REDIS_URL=redis://localhost:16379

STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_PRICE_ID=price_replace

# Recuperação de senha (Resend). Sem chave, o link só aparece nos logs da API.
RESEND_API_KEY=
MAIL_FROM=VOLTTA <onboarding@resend.dev>

WHATSAPP_PROVIDER=uazapi
UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_ADMIN_TOKEN=replace_me_admin_token

# Super-admin do painel /admin (e-mails separados por vírgula)
PLATFORM_ADMIN_EMAILS=
