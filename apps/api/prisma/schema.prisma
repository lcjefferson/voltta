generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
}

enum ScoreClassification {
  LOYAL
  ATTENTION
  RISK
  LOST
}

enum CustomerSegmentType {
  NEW
  FREQUENT
  PREMIUM
  RISK
  LOST
  RECOVERED
}

enum AutomationExecutionStatus {
  SCHEDULED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum WhatsappConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CASH
  CARD
  OTHER
}

enum RoleCode {
  ADMIN
  BARBEIRO
  RECEPCIONISTA
}

enum CustomerLifecycle {
  LEAD
  CUSTOMER
}

enum CustomerSource {
  WHATSAPP
  MANUAL
  BOOKING
  IMPORT
}

model Company {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  slug             String        @unique
  phone            String?
  timezone         String        @default("America/Sao_Paulo")
  logoUrl          String?       @map("logo_url")
  /// Dias/horários de funcionamento: { slotIntervalMinutes, days: { "0"|.."6": { open, close } | null } }
  businessHours    Json?         @map("business_hours")
  status           CompanyStatus @default(TRIALING)
  trialEndsAt      DateTime      @map("trial_ends_at")
  stripeCustomerId String?       @unique @map("stripe_customer_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  users                User[]
  customers            Customer[]
  services             Service[]
  appointments         Appointment[]
  appointmentServices  AppointmentService[]
  customerScores       CustomerScore[]
  customerSegments     CustomerSegment[]
  automationRules      AutomationRule[]
  automationExecutions AutomationExecution[]
  whatsappConnections  WhatsappConnection[]
  subscriptions        Subscription[]
  payments             Payment[]
  revenues             Revenue[]
  notifications        Notification[]
  dashboardMetrics     DashboardMetric[]
  auditLogs            AuditLog[]
  settings             Setting[]
  refreshTokens        RefreshToken[]

  @@map("companies")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        RoleCode         @unique
  name        String
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  code  String           @unique
  name  String
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
  name             String
  email            String
  passwordHash     String    @map("password_hash")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  isActive         Boolean   @default(true) @map("is_active")
  isProfessional   Boolean   @default(false) @map("is_professional")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role                    Role                    @relation(fields: [roleId], references: [id])
  appointments            Appointment[]           @relation("ProfessionalAppointments")
  revenues                Revenue[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model Customer {
  id                 String            @id @default(uuid()) @db.Uuid
  companyId          String            @map("company_id") @db.Uuid
  name               String
  phone              String?
  whatsapp           String?
  email              String?
  birthDate          DateTime?         @map("birth_date") @db.Date
  notes              String?
  marketingOptIn     Boolean           @default(true) @map("marketing_opt_in")
  lifecycleStage     CustomerLifecycle @default(CUSTOMER) @map("lifecycle_stage")
  source             CustomerSource    @default(MANUAL)
  lastInboundAt      DateTime?         @map("last_inbound_at")
  lastInboundMessage String?           @map("last_inbound_message")
  convertedAt        DateTime?         @map("converted_at")
  lifetimeValue      Decimal           @default(0) @map("lifetime_value") @db.Decimal(12, 2)
  totalSpent         Decimal           @default(0) @map("total_spent") @db.Decimal(12, 2)
  avgTicket          Decimal           @default(0) @map("avg_ticket") @db.Decimal(12, 2)
  visitCount         Int               @default(0) @map("visit_count")
  lastVisitAt        DateTime?         @map("last_visit_at")
  nextReturnAt       DateTime?         @map("next_return_at") @db.Date
  deletedAt          DateTime?         @map("deleted_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments         Appointment[]
  score                CustomerScore?
  segments             CustomerSegment[]
  revenues             Revenue[]
  automationExecutions AutomationExecution[]

  @@index([companyId, whatsapp])
  @@index([companyId, lastVisitAt])
  @@index([companyId, name])
  @@index([companyId, lifecycleStage])
  @@map("customers")
}

model Service {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  name               String
  price              Decimal   @db.Decimal(12, 2)
  durationMinutes    Int       @map("duration_minutes")
  returnIntervalDays Int?      @map("return_interval_days")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointmentServices AppointmentService[]
  revenues            Revenue[]

  @@index([companyId, isActive])
  @@map("services")
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  customerId     String            @map("customer_id") @db.Uuid
  professionalId String            @map("professional_id") @db.Uuid
  status         AppointmentStatus @default(PENDING)
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime          @map("ends_at")
  totalAmount    Decimal           @map("total_amount") @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer             Customer              @relation(fields: [customerId], references: [id])
  professional         User                  @relation("ProfessionalAppointments", fields: [professionalId], references: [id])
  services             AppointmentService[]
  revenues             Revenue[]
  automationExecutions AutomationExecution[]

  @@index([companyId, startsAt])
  @@index([companyId, professionalId, startsAt])
  @@index([companyId, status, startsAt])
  @@map("appointments")
}

model AppointmentService {
  id                 String  @id @default(uuid()) @db.Uuid
  companyId          String  @map("company_id") @db.Uuid
  appointmentId      String  @map("appointment_id") @db.Uuid
  serviceId          String  @map("service_id") @db.Uuid
  price              Decimal @db.Decimal(12, 2)
  durationMinutes    Int     @map("duration_minutes")
  returnIntervalDays Int?    @map("return_interval_days")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@index([appointmentId])
  @@map("appointment_services")
}

model CustomerScore {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @map("company_id") @db.Uuid
  customerId         String              @unique @map("customer_id") @db.Uuid
  classification     ScoreClassification
  abandonmentChance  Decimal             @map("abandonment_chance") @db.Decimal(5, 2)
  recommendedAction  String              @map("recommended_action")
  algorithmVersion   String              @default("ScoreVolttaV1") @map("algorithm_version")
  calculatedAt       DateTime            @map("calculated_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId, classification, abandonmentChance(sort: Desc)])
  @@map("customer_scores")
}

model CustomerSegment {
  id         String              @id @default(uuid()) @db.Uuid
  companyId  String              @map("company_id") @db.Uuid
  customerId String              @map("customer_id") @db.Uuid
  segment    CustomerSegmentType
  assignedAt DateTime            @default(now()) @map("assigned_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([companyId, customerId, segment])
  @@index([companyId, segment])
  @@map("customer_segments")
}

model AutomationRule {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  name       String
  trigger    String
  conditions Json     @default("{}")
  actions    Json
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  executions AutomationExecution[]

  @@index([companyId, trigger, isActive])
  @@map("automation_rules")
}

model AutomationExecution {
  id             String                     @id @default(uuid()) @db.Uuid
  companyId      String                     @map("company_id") @db.Uuid
  ruleId         String                     @map("rule_id") @db.Uuid
  customerId     String?                    @map("customer_id") @db.Uuid
  appointmentId  String?                    @map("appointment_id") @db.Uuid
  status         AutomationExecutionStatus  @default(SCHEDULED)
  idempotencyKey String                     @unique @map("idempotency_key")
  payload        Json                       @default("{}")
  scheduledFor   DateTime?                  @map("scheduled_for")
  executedAt     DateTime?                  @map("executed_at")
  errorMessage   String?                    @map("error_message")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rule        AutomationRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  customer    Customer?       @relation(fields: [customerId], references: [id])
  appointment Appointment?    @relation(fields: [appointmentId], references: [id])

  @@index([companyId, scheduledFor])
  @@map("automation_executions")
}

model WhatsappConnection {
  id                   String                    @id @default(uuid()) @db.Uuid
  companyId            String                    @map("company_id") @db.Uuid
  provider             String                    @default("evolution")
  status               WhatsappConnectionStatus  @default(DISCONNECTED)
  instanceName         String?                   @map("instance_name")
  credentialsEncrypted String?                   @map("credentials_encrypted")
  lastHealthcheckAt    DateTime?                 @map("last_healthcheck_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("whatsapp_connections")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  companyId            String             @map("company_id") @db.Uuid
  stripeCustomerId     String             @map("stripe_customer_id")
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?          @map("current_period_end")
  graceUntil           DateTime?          @map("grace_until")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([companyId])
  @@map("subscriptions")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  subscriptionId   String?       @map("subscription_id") @db.Uuid
  stripeInvoiceId  String?       @unique @map("stripe_invoice_id")
  amount           Decimal       @db.Decimal(12, 2)
  status           PaymentStatus @default(PENDING)
  paidAt           DateTime?     @map("paid_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([companyId])
  @@map("payments")
}

model Revenue {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  customerId     String?        @map("customer_id") @db.Uuid
  appointmentId  String?        @map("appointment_id") @db.Uuid
  professionalId String?        @map("professional_id") @db.Uuid
  serviceId      String?        @map("service_id") @db.Uuid
  amount         Decimal        @db.Decimal(12, 2)
  paymentMethod  PaymentMethod  @default(OTHER) @map("payment_method")
  revenueDate    DateTime       @map("revenue_date") @db.Date
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id])
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  professional User?        @relation(fields: [professionalId], references: [id])
  service      Service?     @relation(fields: [serviceId], references: [id])

  @@index([companyId, revenueDate])
  @@map("revenues")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  body      Json     @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, read])
  @@map("notifications")
}

model DashboardMetric {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  metricDate DateTime @map("metric_date") @db.Date
  metrics    Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, metricDate])
  @@map("dashboard_metrics")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorUserId], references: [id])

  @@index([companyId, createdAt])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@map("settings")
}
