# Root
NODE_ENV=development

# API
API_PORT=3001
# API pública (webhooks Uazapi precisam alcançar esta URL)
API_URL=http://localhost:3001
WEBHOOK_PUBLIC_URL=http://localhost:3001
WEB_URL=http://localhost:3000
JWT_ACCESS_SECRET=voltta-dev-access-secret-change-me
JWT_REFRESH_SECRET=voltta-dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Super-admin do painel /admin (e-mails separados por vírgula)
PLATFORM_ADMIN_EMAILS=

# Database
DATABASE_URL=postgresql://voltta:voltta@localhost:15432/voltta?schema=public

# Redis
REDIS_URL=redis://localhost:16379

# Stripe (placeholders)
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_PRICE_ID=price_replace

# WhatsApp — Uazapi (https://docs.uazapi.com/)
WHATSAPP_PROVIDER=uazapi
UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_ADMIN_TOKEN=replace_me_admin_token

# Legacy / alternate (não usado no MVP)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Storage
S3_ENDPOINT=
S3_BUCKET=voltta
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ---------------------------------------------------------------------------
# Produção / Coolify — ver .env.coolify.example e docs/09-coolify-deploy.md
# ---------------------------------------------------------------------------
