{
  "name": "voltta",
  "version": "1.0.0",
  "private": true,
  "description": "VOLTTA™ — Seu cliente sempre de volta. SaaS de retenção para barbearias.",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=api && npm run build --workspace=web",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "prisma:generate": "npm run prisma:generate --workspace=api",
    "prisma:migrate": "npm run prisma:migrate --workspace=api",
    "prisma:seed": "npm run prisma:seed --workspace=api",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "test:api": "npm run test --workspace=api"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
